<workout_file>
  <author>cycling coach</author>
  <name>Wk06 Wed - Threshold 3x12</name>
  <description>Threshold 95-105% FTP, 5 min easy between.</description>
  <sportType>bike</sportType>
  <tags><tag name="CUSTOM 12 WEEK PLAN"/></tags>
  <workout>
    <Warmup Duration="900" PowerLow="0.45" PowerHigh="0.70"/>
    <IntervalsT Repeat="3" OnDuration="720" OffDuration="300" OnPower="1.0" OffPower="0.55"/>
    <SteadyState Duration="540" Power="0.65"/>
    <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
