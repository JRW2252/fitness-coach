<workout_file>
  <author>cycling coach</author>
  <name>Wk02 Fri - Z2 + 6x30s Spin-Ups</name>
  <description>Z2 with 6x30s high-cadence spin-ups (110+ rpm), not hard on power.</description>
  <sportType>bike</sportType>
  <tags><tag name="CUSTOM 12 WEEK PLAN"/></tags>
  <workout>
    <Warmup Duration="900" PowerLow="0.45" PowerHigh="0.70"/>
    <SteadyState Duration="600" Power="0.65"/>
    <IntervalsT Repeat="6" OnDuration="30" OffDuration="150" OnPower="0.72" OffPower="0.65" Cadence="110"/>
    <SteadyState Duration="1320" Power="0.65"/>
    <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
