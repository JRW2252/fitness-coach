<workout_file>
  <author>cycling coach</author>
  <name>Wk06 Fri - VO2 Max 6x3 min</name>
  <description>VO2 110-120% FTP, equal-time easy recovery.</description>
  <sportType>bike</sportType>
  <tags><tag name="CUSTOM 12 WEEK PLAN"/></tags>
  <workout>
    <Warmup Duration="900" PowerLow="0.45" PowerHigh="0.70"/>
    <IntervalsT Repeat="6" OnDuration="180" OffDuration="180" OnPower="1.15" OffPower="0.5"/>
    <SteadyState Duration="840" Power="0.65"/>
    <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
