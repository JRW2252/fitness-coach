<workout_file>
  <author>cycling coach</author>
  <name>Wk07 Fri - VO2 Max 4x2 min</name>
  <description>Short VO2 on the lighter week. 110-120% FTP, equal-time easy recovery.</description>
  <sportType>bike</sportType>
  <tags><tag name="CUSTOM 12 WEEK PLAN"/></tags>
  <workout>
    <Warmup Duration="900" PowerLow="0.45" PowerHigh="0.70"/>
    <IntervalsT Repeat="4" OnDuration="120" OffDuration="120" OnPower="1.15" OffPower="0.5"/>
    <SteadyState Duration="540" Power="0.65"/>
    <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
