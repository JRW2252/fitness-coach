<workout_file>
  <author>cycling coach</author>
  <name>Wk12 Wed - Openers 2x8 Threshold</name>
  <description>Openers before the FTP test. Crisp, not exhausting.</description>
  <sportType>bike</sportType>
  <tags><tag name="CUSTOM 12 WEEK PLAN"/></tags>
  <workout>
    <Warmup Duration="900" PowerLow="0.45" PowerHigh="0.70"/>
    <IntervalsT Repeat="2" OnDuration="480" OffDuration="300" OnPower="1.0" OffPower="0.55"/>
    <SteadyState Duration="900" Power="0.65"/>
    <IntervalsT Repeat="3" OnDuration="30" OffDuration="150" OnPower="1.2" OffPower="0.5"/>
    <Cooldown Duration="600" PowerLow="0.60" PowerHigh="0.40"/>
  </workout>
</workout_file>
